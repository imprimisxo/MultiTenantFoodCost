{
  "name": "restaurant-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented foundation for a multi-tenant restaurant management SaaS.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:advisors": "supabase db advisors --local --type all --level warn --fail-on warn",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase db start",
    "db:stop": "supabase stop --project-id restaurant-saas",
    "db:test": "supabase test db",
    "db:verify": "pnpm db:reset && pnpm db:lint && pnpm db:advisors && pnpm db:test",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.22.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
