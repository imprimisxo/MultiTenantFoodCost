# Public browser-safe configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only configuration. Never prefix these values with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:postgres@localhost:55322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:55322/postgres
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Runtime defaults
NODE_ENV=development
